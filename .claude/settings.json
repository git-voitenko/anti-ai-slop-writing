{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/tools/main-checkout-ff.sh\"",
            "timeout": 30,
            "statusMessage": "main checkout: ff до origin/main"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash tools/verify.sh:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)"
    ]
  }
}
